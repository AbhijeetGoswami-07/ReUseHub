# ==============================================================================
# ReUseHub Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your project root and update with your actual keys.
# NEVER commit '.env' or your Supabase service_role secret key to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration (Required for Live Backend)
# ------------------------------------------------------------------------------
# Obtain these values from your Supabase Dashboard:
# Settings -> API -> Project URL & Project API Keys
# NOTE: ONLY use the public 'anon' key here. NEVER expose your 'service_role' key!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key-here

# ------------------------------------------------------------------------------
# 2. Google Gemini Vision API (Optional - For AI-powered Image Recognition)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# If left empty, ReUseHub automatically falls back to its deterministic rule engine.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Application Environment Mode
# ------------------------------------------------------------------------------
VITE_APP_ENV=development

# ==============================================================================
# DATABASE & STORAGE SETUP INSTRUCTIONS:
# ==============================================================================
# 1. DATABASE MIGRATIONS:
#    Run the comprehensive master migration file located at:
#    'supabase/migrations/20261125_backend_audit.sql'
#    You can apply this in the Supabase Dashboard SQL Editor or via CLI:
#    $ npx supabase db push
#
# 2. REQUIRED STORAGE BUCKETS:
#    Ensure the following 4 public buckets are created (the migration script
#    creates these automatically with proper Row-Level Security policies):
#    - profile-images      (User avatars & profile banners, max 5MB)
#    - product-images      (Product analyzer item photos, max 5MB)
#    - marketplace-images  (Marketplace listing galleries, max 5MB)
#    - community-images    (Community showcase project photos, max 5MB)
#
# 3. ROW-LEVEL SECURITY (RLS):
#    All 12 tables and storage objects enforce strict Row Level Security:
#    - Public read where appropriate (e.g. approved listings, community posts, ideas)
#    - Owner-only write (insert/update/delete based on auth.uid())
#    - Sensitive user contact emails in inquiries/reports restricted to participants & admins
# ==============================================================================
